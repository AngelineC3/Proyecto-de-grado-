\newcommand{\insertarlogoportada}{
  \IfFileExists{\pg@logoportada}{\includegraphics[height=2cm]{\pg@logoportada}}{
    \IfFileExists{\pg@logoportada.pdf}{\includegraphics[height=2cm]{\pg@logoportada}}{
      \IfFileExists{\pg@logoportada.png}{\includegraphics[height=2cm]{\pg@logoportada}}{
        \IfFileExists{\pg@logoportada.PNG}{\includegraphics[height=2cm]{\pg@logoportada}}{
          \IfFileExists{\pg@logoportada.jpg}{\includegraphics[height=2cm]{\pg@logoportada}}{
            \IfFileExists{\pg@logoportada.JPG}{\includegraphics[height=2cm]{\pg@logoportada}}{
              \IfFileExists{\pg@logoportada.jpeg}{\includegraphics[height=2cm]{\pg@logoportada}}{
                \IfFileExists{\pg@logoportada.JPEG}{\includegraphics[height=2cm]{\pg@logoportada}}{
                  \fbox{\parbox[c][2cm][c]{3.2cm}{\centering\small logoportada}}
                }
              }
            }
          }
        }
      }
    }
  }
}

\newcommand{\insertarlogoencabezado}{
  \IfFileExists{\pg@logoencabezado}{\includegraphics[height=1.85cm]{\pg@logoencabezado}}{
    \fbox{\parbox[c][1.85cm][c]{3cm}{\centering\small LOGO IUB}}
  }
}

\newcommand{\encabezadoCapstone}{%
  \begingroup
  \pg@estiloTablasfalse
  \color{black}%
  \arrayrulecolor{black}%
  \setlength{\tabcolsep}{0pt}%
  \setlength{\arrayrulewidth}{0.4pt}%
  \renewcommand{\arraystretch}{1.05}%
  \begin{tabular}{|m{\dimexpr0.20\textwidth-\arrayrulewidth\relax}|m{\dimexpr0.60\textwidth-\arrayrulewidth\relax}|m{\dimexpr0.20\textwidth-2\arrayrulewidth\relax}|}
    \hline
    \centering\insertarlogoencabezado &
    \centering{\bfseries PLANTILLA CAPSTONE DESIGN} &
    \centering{\scriptsize\bfseries FR-IEI-45-V4\\Vigencia: 09/06/2026\\Pág. \thepage{} de \pageref{LastPage}}
    \tabularnewline
    \hline
  \end{tabular}%
  \endgroup
}

